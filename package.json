{
  "name": "osnova-runtime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.5.2",
  "bin": {
    "osnova-runtime": "./dist/cli.js"
  },
  "files": ["dist", "docs", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./client": {
      "types": "./dist/rpc-client.d.ts",
      "import": "./dist/rpc-client.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node -e \"require('node:fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js",
    "doctor": "node dist/cli.js doctor",
    "selftest": "node dist/cli.js selftest"
  },
  "dependencies": {
    "@osnova/manifest": "file:../osnova-core/packages/manifest",
    "@osnova/plugin-sdk": "file:../osnova-plugin-sdk",
    "@osnova/project": "file:../osnova-core/packages/project",
    "@osnova/types": "file:../osnova-core/packages/types",
    "@osnova/validation": "file:../osnova-core/packages/validation"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
